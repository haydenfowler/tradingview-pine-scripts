        if not na(euOpenLine)
            line.delete(euOpenLine)
            euOpenLine := na
        _h = line.new(euSessHighBar, euSessHigh, bar_index, euSessHigh,
                      color=euLineColor, style=lineStyleVal, width=hiLoLineWidth)
        _l = line.new(euSessLowBar,  euSessLow,  bar_index, euSessLow,
                      color=euLineColor, style=lineStyleVal, width=hiLoLineWidth)
        array.push(euHighLines,  _h)
        array.push(euLowLines,   _l)
        array.push(euHighLevels, euSessHigh)
        array.push(euLowLevels,  euSessLow)
        array.push(euHighDone,   false)
        array.push(euLowDone,    false)
        if array.size(euHighLines) > hiLoLookback
            line.delete(array.shift(euHighLines))
            line.delete(array.shift(euLowLines))
            array.shift(euHighLevels)
            array.shift(euLowLevels)
            array.shift(euHighDone)
            array.shift(euLowDone)

if showSessionHiLo and showEUSession and array.size(euHighLines) > 0
    for i = 0 to array.size(euHighLines) - 1
        if not array.get(euHighDone, i)
            ln = array.get(euHighLines, i)
            if high >= array.get(euHighLevels, i)
                line.set_x2(ln, bar_index)
                array.set(euHighDone, i, true)
            else
                line.set_x2(ln, bar_index)
    for i = 0 to array.size(euLowLines) - 1
        if not array.get(euLowDone, i)
            ln = array.get(euLowLines, i)
            if low <= array.get(euLowLevels, i)
                line.set_x2(ln, bar_index)
                array.set(euLowDone, i, true)
            else
                line.set_x2(ln, bar_index)

euWasInSess := isEUSession

// ─── US/NY Session High/Low Lines ─────────────────────────────────────────────
var float   usSessHigh    = na
var float   usSessLow     = na
var float   usSessOpen    = na
var int     usSessHighBar = na
var int     usSessLowBar  = na
var bool    usWasInSess   = false
var line    usOpenLine    = na
var line[]  usHighLines   = array.new_line()
var line[]  usLowLines    = array.new_line()
var float[] usHighLevels  = array.new_float()
var float[] usLowLevels   = array.new_float()
