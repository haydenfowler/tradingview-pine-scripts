//@version=6
indicator(title='Simple Sessions', shorttitle='Simple Sessions', overlay=true, max_labels_count=500, max_lines_count=200)

showUSSession   = input.bool(title="US (New York) Session", defval=true, group="US Session Display Settings", inline="us1", display=display.none)
usSessionColor  = input.color(title="", defval=color.rgb(229, 204, 255, 85), group="US Session Display Settings", inline="us1", tooltip="Background highlight colour for the US session.", display=display.none)
usLineColor     = input.color(title="Line", defval=color.rgb(160, 100, 240, 55), group="US Session Display Settings", inline="us1", tooltip="Colour for US session high/low lines.", display=display.none)
usSessInput     = input.session(title="Local Time (America/New_York)", defval="0800-1600", group="US Session Display Settings", display=display.none)

showEUSession   = input.bool(title="Europe (London) Session", defval=true, group="EU Session Display Settings", inline="eu", display=display.none)
euSessionColor  = input.color(title="", defval=color.rgb(204, 229, 255, 85), group="EU Session Display Settings", inline="eu", tooltip="Background highlight colour for the EU session.", display=display.none)
euLineColor     = input.color(title="Line", defval=color.rgb(80, 160, 240, 55), group="EU Session Display Settings", inline="eu", tooltip="Colour for EU session high/low lines.", display=display.none)
euSessInput     = input.session(title="Local Time (Europe/London)", defval="0800-1700", group="EU Session Display Settings", display=display.none)

showMixedSession  = input.bool(title="Mixed (US/Europe) Session", defval=false, group="EU/US Mixed Session Display Settings", inline="mix", display=display.none)
mixedSessionColor = input.color(title="", defval=color.rgb(150, 150, 255, 85), group="EU/US Mixed Session Display Settings", inline="mix", tooltip="Background highlight colour for the US/EU overlap session.\n\nNote: This session is the calculated overlap of the US and EU sessions above, so there is no custom time window for this session.", display=display.none)

showAUSession  = false
auSessionColor = color.rgb(0, 0, 0, 100)
auSessInput    = "0000-0000"

showJPSession   = input.bool(title="Asia/Japan (Tokyo) Session", defval=true, group="JP Session Display Settings", inline="jp", display=display.none)
jpSessionColor  = input.color(title="", defval=color.rgb(255, 255, 204, 75), group="JP Session Display Settings", inline="jp", tooltip="Background highlight colour for the Asia/Tokyo session.", display=display.none)
jpLineColor     = input.color(title="Line", defval=color.rgb(220, 190, 30, 55), group="JP Session Display Settings", inline="jp", tooltip="Colour for Asia session high/low lines.", display=display.none)
jpSessInput     = input.session(title="Local Time (Asia/Tokyo)", defval="0800-1600", group="JP Session Display Settings", display=display.none)

showCustomSession   = input.bool(title="User-Defined Custom Session", defval=false, group="User-Defined (Custom) Session", inline="cust", display=display.none)
custSessionColor    = input.color(title="", defval=color.rgb(125, 125, 125, 85), group="User-Defined (Custom) Session", inline="cust", tooltip="Background highlight colour for the custom session.", display=display.none)
custLineColor       = input.color(title="Line", defval=color.rgb(150, 150, 150, 55), group="User-Defined (Custom) Session", inline="cust", tooltip="Colour for custom session high/low lines.", display=display.none)
custSessionSession  = input.session(defval="0800-1600", title="Custom Session Time Window", group="User-Defined (Custom) Session", tooltip="Time window for the custom session.", display=display.none)
custSessTimezone    = input.string(defval="Etc/UTC", title="Custom Session Timezone",
     options=["UTC", "America/Los_Angeles", "America/Phoenix", "America/Vancouver", "America/El_Salvador", "America/Bogota", "America/Chicago", "America/New_York", "America/Toronto",
             "America/Argentina/Buenos_Aires", "America/Sao_Paulo", "Etc/UTC", "GMT", "Europe/London", "Europe/Berlin", "Europe/Madrid", "Europe/Paris", "Europe/Warsaw", "Europe/Athens",
             "Europe/Moscow", "Asia/Tehran", "Asia/Dubai", "Asia/Ashkhabad", "Asia/Kolkata", "Asia/Almaty", "Asia/Bangkok", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore",
             "Asia/Taipei", "Asia/Seoul", "Asia/Tokyo", "Australia/ACT", "Australia/Adelaide", "Australia/Brisbane", "Australia/Sydney", "Pacific/Auckland", "Pacific/Fakaofo", "Pacific/Chatham", "Pacific/Honolulu"],
     group="User-Defined (Custom) Session", tooltip="Reference timezone for the custom session time window.", display=display.none)

showSessionHiLo = input.bool(title="Show Session High/Low Lines", defval=true, group="Session High/Low Settings",
     tooltip="Draws lines from the candle that made the session high/low, extending right until price invalidates that level.", display=display.none)
hiLoLookback    = input.int(title="Sessions to Display", defval=1, minval=1, maxval=10, group="Session High/Low Settings",
     tooltip="Number of past closed sessions for which to display high/low lines.", display=display.none)
hiLoLineWidth   = input.int(title="Line Width", defval=1, minval=1, maxval=4, group="Session High/Low Settings", display=display.none)
hiLoLineStyle   = input.string(title="Line Style", defval="Solid", options=["Solid", "Dashed", "Dotted"], group="Session High/Low Settings", display=display.none)

incSun  = input.bool(defval=false, title="Sunday",    group="Session Days of the Week", display=display.none)
incMon  = input.bool(defval=true,  title="Monday",    group="Session Days of the Week", display=display.none)
incTue  = input.bool(defval=true,  title="Tuesday",   group="Session Days of the Week", display=display.none)
incWed  = input.bool(defval=true,  title="Wednesday", group="Session Days of the Week", display=display.none)
incThur = input.bool(defval=true,  title="Thursday",  group="Session Days of the Week", display=display.none)
incFri  = input.bool(defval=true,  title="Friday",    group="Session Days of the Week", display=display.none)
incSat  = input.bool(defval=false, title="Saturday",  group="Session Days of the Week", display=display.none)

sessionDays = (incSun ? "1" : "") + (incMon ? "2" : "") + (incTue ? "3" : "") + (incWed ? "4" : "") + (incThur ? "5" : "") + (incFri ? "6" : "") + (incSat ? "7" : "")

usSession   = usSessInput        + ":" + sessionDays
euSession   = euSessInput        + ":" + sessionDays
auSession   = auSessInput        + ":" + sessionDays
jpSession   = jpSessInput        + ":" + sessionDays
custSession = custSessionSession + ":" + sessionDays

isInSession(simple string session, simple string ref_timezone) =>
    timeframe.isintraday and not na(time(timeframe.period, session, ref_timezone))

isUSSession        = isInSession(usSession,   "America/New_York")
isEUSession        = isInSession(euSession,   "Europe/London")
isAUSession        = isInSession(auSession,   "Australia/Sydney")
isJPSession        = isInSession(jpSession,   "Asia/Tokyo")
isCustomSession    = isInSession(custSession, custSessTimezone)
isUSEUMixedSession = isUSSession and isEUSession

lineStyleVal = hiLoLineStyle == "Dashed" ? line.style_dashed : hiLoLineStyle == "Dotted" ? line.style_dotted : line.style_solid

nullColor = color.rgb(0, 0, 0, 100)
bgcolor(title="US Session",          color=showUSSession    ? isUSSession        ? usSessionColor    : nullColor : nullColor, editable=false)
bgcolor(title="EU Session",          color=showEUSession    ? isEUSession        ? euSessionColor    : nullColor : nullColor, editable=false)
bgcolor(title="AU Session",          color=showAUSession    ? isAUSession        ? auSessionColor    : nullColor : nullColor, editable=false)
bgcolor(title="JP Session",          color=showJPSession    ? isJPSession        ? jpSessionColor    : nullColor : nullColor, editable=false)
bgcolor(title="US/EU Mixed Session", color=showMixedSession ? isUSEUMixedSession ? mixedSessionColor : nullColor : nullColor, editable=false)
bgcolor(title="User-Defined Session",color=showCustomSession? isCustomSession    ? custSessionColor  : nullColor : nullColor, editable=false)

// ─── JP/Asia Session High/Low Lines ───────────────────────────────────────────
var float   jpSessHigh    = na
var float   jpSessLow     = na
var float   jpSessOpen    = na
var int     jpSessHighBar = na
var int     jpSessLowBar  = na
var bool    jpWasInSess   = false
var line    jpOpenLine    = na
var line[]  jpHighLines   = array.new_line()
var line[]  jpLowLines    = array.new_line()
var float[] jpHighLevels  = array.new_float()
var float[] jpLowLevels   = array.new_float()
var bool[]  jpHighDone    = array.new_bool()
var bool[]  jpLowDone     = array.new_bool()

if isJPSession and not jpWasInSess
    if showSessionHiLo and showJPSession and array.size(jpHighLines) > 0
        for i = 0 to array.size(jpHighLines) - 1
            if not array.get(jpHighDone, i)
                line.set_x2(array.get(jpHighLines, i), bar_index)
                array.set(jpHighDone, i, true)
        for i = 0 to array.size(jpLowLines) - 1
            if not array.get(jpLowDone, i)
                line.set_x2(array.get(jpLowLines, i), bar_index)
                array.set(jpLowDone, i, true)
    jpSessHighBar := bar_index
    jpSessLowBar  := bar_index
    jpSessOpen    := open
    jpSessHigh    := high
    jpSessLow     := low
    if showSessionHiLo and showJPSession
        if not na(jpOpenLine)
            line.delete(jpOpenLine)
        jpOpenLine := line.new(bar_index, jpSessOpen, bar_index, jpSessOpen,
                               color=jpLineColor, style=line.style_dashed,
                               width=hiLoLineWidth, extend=extend.right)

if isJPSession
    if high > jpSessHigh
        jpSessHigh    := high
        jpSessHighBar := bar_index
    if low < jpSessLow
        jpSessLow    := low
        jpSessLowBar := bar_index

if not isJPSession and jpWasInSess
    if showSessionHiLo and showJPSession
        if not na(jpOpenLine)
            line.delete(jpOpenLine)
            jpOpenLine := na
        _h = line.new(jpSessHighBar, jpSessHigh, bar_index, jpSessHigh,
                      color=jpLineColor, style=lineStyleVal, width=hiLoLineWidth)
        _l = line.new(jpSessLowBar,  jpSessLow,  bar_index, jpSessLow,
                      color=jpLineColor, style=lineStyleVal, width=hiLoLineWidth)
        array.push(jpHighLines,  _h)
        array.push(jpLowLines,   _l)
        array.push(jpHighLevels, jpSessHigh)
        array.push(jpLowLevels,  jpSessLow)
        array.push(jpHighDone,   false)
        array.push(jpLowDone,    false)
        if array.size(jpHighLines) > hiLoLookback
            line.delete(array.shift(jpHighLines))
            line.delete(array.shift(jpLowLines))
            array.shift(jpHighLevels)
            array.shift(jpLowLevels)
            array.shift(jpHighDone)
            array.shift(jpLowDone)

if showSessionHiLo and showJPSession and array.size(jpHighLines) > 0
    for i = 0 to array.size(jpHighLines) - 1
        if not array.get(jpHighDone, i)
            ln = array.get(jpHighLines, i)
            if high >= array.get(jpHighLevels, i)
                line.set_x2(ln, bar_index)
                array.set(jpHighDone, i, true)
            else
                line.set_x2(ln, bar_index)
    for i = 0 to array.size(jpLowLines) - 1
        if not array.get(jpLowDone, i)
            ln = array.get(jpLowLines, i)
            if low <= array.get(jpLowLevels, i)
                line.set_x2(ln, bar_index)
                array.set(jpLowDone, i, true)
            else
                line.set_x2(ln, bar_index)

jpWasInSess := isJPSession

// ─── EU/London Session High/Low Lines ─────────────────────────────────────────
var float   euSessHigh    = na
var float   euSessLow     = na
var float   euSessOpen    = na
var int     euSessHighBar = na
var int     euSessLowBar  = na
var bool    euWasInSess   = false
var line    euOpenLine    = na
var line[]  euHighLines   = array.new_line()
var line[]  euLowLines    = array.new_line()
var float[] euHighLevels  = array.new_float()
var float[] euLowLevels   = array.new_float()
